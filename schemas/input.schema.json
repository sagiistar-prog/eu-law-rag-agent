{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EU Law Evidence Lab input",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "review_status": {
            "enum": [
              "pending",
              "reviewed",
              "fictional"
            ],
            "default": "pending"
          }
        },
        "required": [
          "source_id",
          "source_title",
          "source_url",
          "retrieved_at",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "max_words_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "retrieval_mode": {
      "enum": [
        "hybrid",
        "keyword"
      ],
      "default": "hybrid"
    }
  },
  "required": [
    "query",
    "documents"
  ],
  "additionalProperties": false
}
