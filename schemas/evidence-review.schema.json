{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "query",
    "answer_status",
    "answer_mode",
    "manual_review_required",
    "confidence",
    "next_step",
    "instrument",
    "corpus_sha256",
    "created_at",
    "version_scope",
    "evidence",
    "candidates",
    "review_candidates"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "answer_status": {
      "enum": [
        "evidence_found",
        "insufficient_evidence"
      ]
    },
    "answer_mode": {
      "const": "extractive"
    },
    "manual_review_required": {
      "const": true
    },
    "confidence": {
      "const": "unrated"
    },
    "next_step": {
      "type": "string"
    },
    "instrument": {
      "type": "string"
    },
    "corpus_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "version_scope": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hit"
      },
      "maxItems": 5
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hit"
      },
      "maxItems": 5
    },
    "review_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hit"
      },
      "maxItems": 5
    },
    "storage": {
      "enum": [
        "postgres-pgvector",
        "local-json"
      ]
    },
    "markdown": {
      "type": "string"
    },
    "ranking": {
      "type": "object",
      "required": [
        "method",
        "model",
        "revision",
        "model_sha256",
        "score_kind",
        "minimum_logit",
        "max_logit_gap"
      ],
      "properties": {
        "method": {
          "const": "hybrid-cross-encoder"
        },
        "score_kind": {
          "const": "uncalibrated_logit"
        },
        "minimum_logit": {
          "type": "number"
        },
        "max_logit_gap": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hit": {
      "type": "object",
      "required": [
        "source_id",
        "source_title",
        "source_url",
        "retrieved_at",
        "text",
        "keyword_score",
        "review_status",
        "chunk_id"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "fictional",
            "pending",
            "reviewed",
            "source_verified"
          ]
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "keyword_score": {
          "type": "number"
        },
        "cosine_similarity": {
          "type": [
            "number",
            "null"
          ]
        },
        "rerank_score": {
          "type": "number"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the exact UTF-8 text emitted in this hit."
        },
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code-point offset in the cleaned source, inclusive."
        },
        "char_end": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code-point offset in the cleaned source, exclusive."
        },
        "truncated": {
          "type": "boolean"
        },
        "excerpt_of": {
          "type": "object",
          "required": [
            "content_sha256"
          ],
          "description": "Original scored passage provenance when the emitted excerpt is shortened.",
          "properties": {
            "chunk_id": {
              "type": "string"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "char_start": {
              "type": "integer",
              "minimum": 0
            },
            "char_end": {
              "type": "integer",
              "minimum": 0
            },
            "context_char_end": {
              "type": "integer",
              "minimum": 0
            },
            "matched_chunk_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
