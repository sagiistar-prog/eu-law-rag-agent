{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_title",
    "source_url",
    "retrieved_at",
    "chunk_id",
    "text",
    "content_sha256",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^(https?://|urn:local:sha256:)"
    },
    "retrieved_at": {
      "type": "string"
    },
    "chunk_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_status": {
      "enum": [
        "pending",
        "reviewed",
        "fictional",
        "source_verified"
      ]
    },
    "page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "section": {
      "type": "string"
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "language": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string"
    },
    "celex": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "document_version": {
      "type": "string"
    },
    "version_notice": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
